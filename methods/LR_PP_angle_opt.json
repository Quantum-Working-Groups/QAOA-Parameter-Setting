{
    "trainer_chain": [
        {
            "trainer": "TQATrainer",
            "trainer_init": {
                "evaluator": "PPEvaluator",
                "evaluator_init": {"pp_kwargs": {"max_weight": 3, "min_abs_coeff": 0.0001}},
                "initial_dt":[0.5, 0.5]
            },
            
            "train_kwargs": {"reps":10}
        },
        {
            "trainer": "ScipyTrainer",
            "trainer_init": {
                "evaluator": "PPEvaluator",
                "evaluator_init": {"pp_kwargs": {"max_weight": 3, "min_abs_coeff": 0.0001}},
                "minimize_args": {"options": {"maxiter": 100, "rhobeg": 0.2}}
            },
            "train_kwargs": {
                "result": {
                    "optimized_qaoa_angles": "params0"
                }
            }
        }
    ],
    "description": "optimized TQATrainer with PPEvaluator"
}