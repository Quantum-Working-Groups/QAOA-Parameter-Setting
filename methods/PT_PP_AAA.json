{
    "trainer_chain": [
        {
            "trainer": "TransferTrainer",
            "trainer_init": {
                "data_loader": "LoadFromJson",
                "data_loader_init": {
                    "function_name": "LoadFromJson",
                    "file_name": "../../angles_data_test.json"
                },
                "feature_extractor": "GraphFeatureExtractor",
                "feature_extractor_init": {
                    "feature_extractor_name": "GraphFeatureExtractor",
                    "extract_num_nodes": false,
                    "extract_num_edges": false,
                    "extract_avg_node_degree": true,
                    "extract_avg_edge_weights": true,
                    "extract_standard_devs": true,
                    "extract_density": false
                },
                "feature_matcher": "TrivialFeatureMatcher",
                "feature_matcher_init": {},
                "angle_aggregator": "AverageAngleAggregator",
                "angle_aggregator_init": {
                    "angle_aggregator_name": "AverageAngleAggregator",
                    "axis": [
                        0
                    ]
                },
                "evaluator": "PPEvaluator",
                "evaluator_init": {
                    "pp_kwargs": {
                        "max_weight": 4,
                        "min_abs_coeff": 1e-10,
                        "max_freq": Infinity,
                        "max_sins": Infinity,
                        "customtruncfunc": null,
                        "max_abs_coeff": 0.0001
                    }
                }
            },
            "train_kwargs": {}
        }
    ]
}